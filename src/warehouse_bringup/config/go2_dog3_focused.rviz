Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 80
      Cell Size: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Go2 dog_3 Complete URDF
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /dog_3/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      TF Prefix: dog_3
      Update Interval: 0
    - Class: rviz_default_plugins/TF
      Name: Go2 TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: false
      Show Axes: false
      Show Names: false
    - Class: rviz_default_plugins/Path
      Name: Go2 Travelled Path
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Color: 25; 255; 0
      Pose Style: None
      Topic:
        Value: /dog_3/path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/PointCloud2
      Name: Warehouse 3D PCD
      Enabled: true
      Alpha: 0.45
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Size (Pixels): 1
      Size (m): 0.012
      Style: Flat Squares
      Topic:
        Value: /map_generator/global_cloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Go2 Local Sensor Cloud
      Enabled: true
      Alpha: 0.35
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Value: /dog_3/cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Use Fixed Frame: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Focused Go2 View
      Distance: 11
      Focal Point:
        X: -17.5
        Y: -14.5
        Z: 2.4
      Pitch: 0.62
      Yaw: 0.78
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Value: Orbit (rviz_default_plugins)
Window Geometry:
  Height: 920
  Width: 1320
  Hide Left Dock: false
  Hide Right Dock: true
